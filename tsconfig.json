{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "supabase/functions",
    // El Worker de Cloudflare corre en workerd, no en React Native: sus tipos globales
    // (Fetcher, Request de workers-types…) chocan con los del DOM/RN. Se comprueba
    // aparte, con tsconfig.worker.json.
    "worker",
    "dist"
  ]
}
